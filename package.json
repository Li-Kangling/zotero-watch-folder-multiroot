{
  "name": "zotero-watch-folder-multiroot",
  "version": "2.8.6.4",
  "description": "Multiple independent local folders mirrored to Zotero collections",
  "author": "Li-Kangling; based on Zotero Watch Folder by Jose Siqueira",
  "license": "GPL-3.0-only",
  "scripts": {
    "build": "node build/multiroot.mjs",
    "bundle": "node build/multiroot.mjs",
    "package": "node build/multiroot.mjs",
    "source": "node build/source-archive.mjs",
    "release": "npm test && npm run build && npm run source && node build/release-upload.mjs",
    "release:upload": "node build/release-upload.mjs",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "archiver": "^7.0.0",
    "esbuild": "^0.28.0",
    "vitest": "^4.1.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Li-Kangling/zotero-watch-folder-multiroot.git"
  },
  "homepage": "https://github.com/Li-Kangling/zotero-watch-folder-multiroot",
  "bugs": {
    "url": "https://github.com/Li-Kangling/zotero-watch-folder-multiroot/issues"
  }
}
